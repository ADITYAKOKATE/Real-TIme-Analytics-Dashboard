# PulseMetrics Environment Variables
# Copy this file to .env and .env.local to configure your environment.

# ==========================================
# Backend Setup (apps/server/.env)
# ==========================================
PORT=4000
NODE_ENV=production

# Database Connections (Update these if not using the default docker-compose setup)
MONGODB_URI=mongodb://admin:analytics123@localhost:27017/analytics?authSource=admin
REDIS_URL=redis://localhost:6379

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=analytics-server
KAFKA_GROUP_ID=analytics-consumer-group

# Alert Channels (Optional)
ALERT_EMAIL_FROM=alerts@analytics.local
SMTP_HOST=localhost
SMTP_PORT=1025
SLACK_WEBHOOK_URL=

# Security
JWT_SECRET=super-secret-jwt-key-change-in-production

# ==========================================
# Frontend Setup (apps/client/.env.local)
# ==========================================
# The public URLs that the browser will use to connect to the backend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
